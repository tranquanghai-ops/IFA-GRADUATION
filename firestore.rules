rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn(){ return request.auth != null && request.auth.token.email_verified == true; }
    function email(){ return request.auth.token.email; }
    function student(){ return signedIn() && email().matches('^[^@]+@student\\.tdtu\\.edu\\.vn$'); }
    function staff(){ return signedIn() && email().matches('^[^@]+@tdtu\\.edu\\.vn$'); }
    function owner(){ return staff() && email() == 'tranquanghai@tdtu.edu.vn'; }
    function admin(){ return owner() || (signedIn() && exists(/databases/$(database)/documents/admins/$(email()))); }

    // ==========================================
    // ADMINS & ACCESS CONTROL
    // ==========================================
    match /settings/main {
      allow read: if signedIn();
      allow create, update, delete: if owner();
    }

    match /admins/{adminEmail} {
      allow get: if owner() || (signedIn() && email() == adminEmail);
      allow list, create, update, delete: if owner();
    }

    match /auditLogs/{logId} {
      allow read: if admin();
      allow create: if (admin() && request.resource.data.actorEmail == email())
        || (signedIn() && request.resource.data.by == email());
      allow update, delete: if false;
    }

    // ==========================================
    // USER ACTIVITY & LOGIN TRACKING
    // ==========================================
    match /userActivities/{userEmail} {
      allow read: if signedIn();
      allow create, update: if signedIn() && (
        email().lower() == userEmail.lower() || admin()
      );
      allow delete: if admin();
    }

    // ==========================================
    // IFA GRADUATION MASTER CATALOGS
    // ==========================================
    
    // Kho GVHD Master
    match /supervisorMaster/{supervisorId} {
      allow read: if signedIn();
      allow create, update, delete: if admin();
    }

    // Danh mục Loại hình đồ án
    match /graduationProjectTypes/{typeId} {
      allow read: if signedIn();
      allow create, update, delete: if admin();
    }

    // Thông tin liên lạc sinh viên bổ sung cho ĐATN
    match /graduationStudentProfiles/{studentId} {
      allow get: if admin() || (student() && email().matches('(?i)^' + studentId + '@student\\.tdtu\\.edu\\.vn$'));
      allow list: if admin();
      allow create, update: if admin() || (student()
        && email().matches('(?i)^' + studentId + '@student\\.tdtu\\.edu\\.vn$')
        && request.resource.data.studentId == studentId
        && request.resource.data.email.lower() == email().lower()
        && (!request.resource.data.keys().hasAll(['currentClass']) || (request.resource.data.currentClass is string && request.resource.data.currentClass.size() <= 50))
        && (!request.resource.data.keys().hasAll(['personalEmail']) || (request.resource.data.personalEmail is string && request.resource.data.personalEmail.size() <= 120))
        && (!request.resource.data.keys().hasAll(['phone']) || (request.resource.data.phone is string && request.resource.data.phone.size() <= 30))
        && (!request.resource.data.keys().hasAll(['permanentAddress']) || (request.resource.data.permanentAddress is string && request.resource.data.permanentAddress.size() <= 250))
        && (!request.resource.data.keys().hasAll(['temporaryAddress']) || (request.resource.data.temporaryAddress is string && request.resource.data.temporaryAddress.size() <= 250))
        && (!request.resource.data.keys().hasAll(['address']) || (request.resource.data.address is string && request.resource.data.address.size() <= 250))
        && (!request.resource.data.keys().hasAll(['updatedAt']) || request.resource.data.updatedAt is timestamp)
        && (!request.resource.data.keys().hasAll(['updatedBy']) || (request.resource.data.updatedBy is string && request.resource.data.updatedBy.lower() == email().lower()))
        && request.resource.data.keys().hasOnly([
          'studentId', 'email', 'currentClass', 'personalEmail', 'phone',
          'permanentAddress', 'temporaryAddress', 'address', 'updatedAt', 'updatedBy'
        ]));
      allow delete: if admin();
    }

    // ==========================================
    // CÁC ĐỢT ĐỒ ÁN TỐT NGHIỆP (GRADUATION ROUNDS)
    // ==========================================
    match /graduationRounds/{roundId} {
      allow read: if signedIn();
      allow create, update, delete: if admin();

      // GVHD tham gia đợt (kèm quota của đợt)
      match /supervisors/{supervisorId} {
        allow read: if signedIn();
        allow create, delete: if admin();
        allow update: if admin() || (staff() && (email() == supervisorId || email() == resource.data.email));
      }

      // Danh sách sinh viên đủ điều kiện
      match /eligibleStudents/{studentId} {
        allow get: if admin() || staff() || (student() && email().matches('(?i)^' + studentId + '@student\\.tdtu\\.edu\\.vn$'));
        allow list: if admin() || staff();
        allow create, update, delete: if admin();
      }

      // Official supervisor assignment exists independently from registration.
      match /officialAssignments/{studentId} {
        allow get: if admin()
          || (resource.data.assignmentStatus == 'published'
            && (
              (student() && email().matches('(?i)^' + studentId + '@student\\.tdtu\\.edu\\.vn$'))
              || staff()
              || (signedIn() && (email() in resource.data.supervisorEmails || email().lower() in resource.data.supervisorEmails))
            ));
        allow list: if admin() || staff();
        allow create: if admin()
          && request.resource.data.studentId == studentId
          && request.resource.data.assignmentStatus == 'published'
          && request.resource.data.supervisors is list
          && request.resource.data.supervisorIds is list
          && request.resource.data.supervisorEmails is list;
        allow update: if admin()
          && request.resource.data.studentId == resource.data.studentId
          && request.resource.data.studentId == studentId
          && request.resource.data.assignmentStatus == 'published'
          && request.resource.data.supervisors is list
          && request.resource.data.supervisorIds is list
          && request.resource.data.supervisorEmails is list;
        allow delete: if admin();
      }

      // Admin-only working copy
      match /assignmentDrafts/{studentId} {
        allow get, list: if admin();
        allow create, update: if admin()
          && request.resource.data.studentId == studentId
          && request.resource.data.assignmentStatus == 'draft'
          && request.resource.data.supervisors is list
          && request.resource.data.supervisorIds is list
          && request.resource.data.supervisorEmails is list;
        allow delete: if admin();
      }

      // Quyết định xét duyệt của GVHD từng vòng
      match /reviewDecisions/{decisionId} {
        allow read: if admin() || staff();
        allow create, update: if admin() || (staff() && (email() == request.resource.data.supervisorEmail || email() == request.resource.data.decidedBy));
        allow delete: if admin();
      }

      // Đăng ký nguyện vọng của sinh viên
      match /registrations/{studentId} {
        allow get: if admin() 
          || (student() && email().matches('(?i)^' + studentId + '@student\\.tdtu\\.edu\\.vn$'))
          || staff()
          || (signedIn() && exists(/databases/$(database)/documents/graduationRounds/$(roundId)/supervisors/$(email())));
        allow list: if admin() || staff();

        allow create: if (admin())
          || (student()
            && email().matches('(?i)^' + studentId + '@student\\.tdtu\\.edu\\.vn$')
            && request.resource.data.studentId == studentId
            && request.resource.data.email.lower() == email().lower()
            && request.resource.data.status == 'submitted'
            && request.resource.data.topicTitle is string
            && request.resource.data.topicTitle.size() > 0
            && request.resource.data.topicTitle.size() <= 250
            && request.resource.data.projectType is string
            && (!request.resource.data.keys().hasAll(['topicApprovalStatus']) || request.resource.data.topicApprovalStatus in ['pending', 'approved', 'rejected'])
            && (!request.resource.data.keys().hasAll(['projectTypes']) || (request.resource.data.projectTypes is list && request.resource.data.projectTypes.size() >= 1 && request.resource.data.projectTypes.size() <= 3))
            && (!request.resource.data.keys().hasAll(['currentClass']) || (request.resource.data.currentClass is string && request.resource.data.currentClass.size() <= 50))
            && (!request.resource.data.keys().hasAll(['personalEmail']) || (request.resource.data.personalEmail is string && request.resource.data.personalEmail.size() <= 120))
            && (!request.resource.data.keys().hasAll(['studentPhone']) || (request.resource.data.studentPhone is string && request.resource.data.studentPhone.size() <= 30))
            && (!request.resource.data.keys().hasAll(['studentPermanentAddress']) || (request.resource.data.studentPermanentAddress is string && request.resource.data.studentPermanentAddress.size() <= 250))
            && (!request.resource.data.keys().hasAll(['studentTemporaryAddress']) || (request.resource.data.studentTemporaryAddress is string && request.resource.data.studentTemporaryAddress.size() <= 250))
            && (!request.resource.data.keys().hasAll(['studentAddress']) || (request.resource.data.studentAddress is string && request.resource.data.studentAddress.size() <= 250))
            && (!request.resource.data.keys().hasAll(['courseName']) || (request.resource.data.courseName is string && request.resource.data.courseName.size() <= 100))
            && (!request.resource.data.keys().hasAll(['courseCode']) || (request.resource.data.courseCode is string && request.resource.data.courseCode.size() <= 30))
            && (!request.resource.data.keys().hasAll(['courseGroup']) || (request.resource.data.courseGroup is string && request.resource.data.courseGroup.size() <= 20))
            && (!request.resource.data.keys().hasAll(['topicDescription']) || (request.resource.data.topicDescription is string && request.resource.data.topicDescription.size() <= 2000))
            && request.resource.data.preferences is list
            && (request.resource.data.preferences.size() > 0
              || (get(/databases/$(database)/documents/graduationRounds/$(roundId)).data.keys().hasAll(['supervisorAssignmentMode'])
                && get(/databases/$(database)/documents/graduationRounds/$(roundId)).data.supervisorAssignmentMode == 'direct_assignment')
              || (exists(/databases/$(database)/documents/graduationRounds/$(roundId)/officialAssignments/$(studentId))
                && get(/databases/$(database)/documents/graduationRounds/$(roundId)/officialAssignments/$(studentId)).data.assignmentStatus == 'published'))
            && (
              (exists(/databases/$(database)/documents/graduationRounds/$(roundId)/eligibleStudents/$(studentId))
               && get(/databases/$(database)/documents/graduationRounds/$(roundId)/eligibleStudents/$(studentId)).data.eligible == true)
              ||
              (get(/databases/$(database)/documents/graduationRounds/$(roundId)).data.allowRegistrationBeforeEligibility == true
               && (!get(/databases/$(database)/documents/graduationRounds/$(roundId)).data.keys().hasAll(['eligibilityFinalized'])
                   || get(/databases/$(database)/documents/graduationRounds/$(roundId)).data.eligibilityFinalized == false))
            )
            && (get(/databases/$(database)/documents/graduationRounds/$(roundId)).data.status in ['open', 'published', 'reviewing', 'finalized']
                || !get(/databases/$(database)/documents/graduationRounds/$(roundId)).data.keys().hasAll(['status']))
            && (!get(/databases/$(database)/documents/graduationRounds/$(roundId)).data.keys().hasAll(['openAt']) 
                || request.time >= get(/databases/$(database)/documents/graduationRounds/$(roundId)).data.openAt)
            && (!get(/databases/$(database)/documents/graduationRounds/$(roundId)).data.keys().hasAll(['closeAt']) 
                || request.time <= get(/databases/$(database)/documents/graduationRounds/$(roundId)).data.closeAt));

        allow update: if (admin())
          || (staff()
            && exists(/databases/$(database)/documents/graduationRounds/$(roundId)/supervisors/$(email()))
            && exists(/databases/$(database)/documents/graduationRounds/$(roundId)/officialAssignments/$(studentId))
            && get(/databases/$(database)/documents/graduationRounds/$(roundId)/officialAssignments/$(studentId)).data.assignmentStatus == 'published'
            && email() in get(/databases/$(database)/documents/graduationRounds/$(roundId)/officialAssignments/$(studentId)).data.supervisorEmails
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'topicApprovalStatus', 'topicApprovalNote', 'topicReviewedAt',
              'topicReviewedBy', 'topicTitleHistory', 'updatedAt'
            ])
            && request.resource.data.topicApprovalStatus in ['approved', 'rejected']
            && request.resource.data.topicApprovalNote is string
            && request.resource.data.topicApprovalNote.size() <= 1000
            && request.resource.data.topicReviewedAt is timestamp
            && request.resource.data.topicReviewedBy == email()
            && request.resource.data.topicTitleHistory is list
            && request.resource.data.topicTitleHistory.size() <= 50
            && request.resource.data.topicTitle == resource.data.topicTitle
            && request.resource.data.studentId == resource.data.studentId)
          || (student()
            && email().matches('(?i)^' + studentId + '@student\\.tdtu\\.edu\\.vn$')
            && resource.data.email.lower() == email().lower()
            && request.resource.data.studentId == studentId
            && request.resource.data.email.lower() == email().lower()
            && request.resource.data.status == resource.data.status
            && (!resource.data.keys().hasAll(['eligibilityStatus']) || request.resource.data.eligibilityStatus == resource.data.eligibilityStatus)
            && request.resource.data.topicTitle is string
            && request.resource.data.topicTitle.size() > 0
            && request.resource.data.topicTitle.size() <= 250
            && request.resource.data.projectType is string
            && (!request.resource.data.keys().hasAll(['projectTypes']) || (request.resource.data.projectTypes is list && request.resource.data.projectTypes.size() >= 1 && request.resource.data.projectTypes.size() <= 3))
            && (!request.resource.data.keys().hasAll(['currentClass']) || (request.resource.data.currentClass is string && request.resource.data.currentClass.size() <= 50))
            && (!request.resource.data.keys().hasAll(['personalEmail']) || (request.resource.data.personalEmail is string && request.resource.data.personalEmail.size() <= 120))
            && (!request.resource.data.keys().hasAll(['studentPhone']) || (request.resource.data.studentPhone is string && request.resource.data.studentPhone.size() <= 30))
            && (!request.resource.data.keys().hasAll(['studentPermanentAddress']) || (request.resource.data.studentPermanentAddress is string && request.resource.data.studentPermanentAddress.size() <= 250))
            && (!request.resource.data.keys().hasAll(['studentTemporaryAddress']) || (request.resource.data.studentTemporaryAddress is string && request.resource.data.studentTemporaryAddress.size() <= 250))
            && (!request.resource.data.keys().hasAll(['studentAddress']) || (request.resource.data.studentAddress is string && request.resource.data.studentAddress.size() <= 250))
            && (!request.resource.data.keys().hasAll(['courseName']) || (request.resource.data.courseName is string && request.resource.data.courseName.size() <= 100))
            && (!request.resource.data.keys().hasAll(['courseCode']) || (request.resource.data.courseCode is string && request.resource.data.courseCode.size() <= 30))
            && (!request.resource.data.keys().hasAll(['courseGroup']) || (request.resource.data.courseGroup is string && request.resource.data.courseGroup.size() <= 20))
            && (!request.resource.data.keys().hasAll(['topicDescription']) || (request.resource.data.topicDescription is string && request.resource.data.topicDescription.size() <= 2000))
            && ((!request.resource.data.keys().hasAll(['topicApprovalStatus'])
                && !resource.data.keys().hasAll(['topicApprovalStatus']))
              || (request.resource.data.topicTitle == resource.data.topicTitle
                && request.resource.data.topicApprovalStatus == resource.data.topicApprovalStatus)
              || (request.resource.data.topicTitle != resource.data.topicTitle
                && request.resource.data.topicApprovalStatus == 'pending'))
            && (!resource.data.keys().hasAll(['topicReviewedBy']) || request.resource.data.topicReviewedBy == resource.data.topicReviewedBy)
            && (!resource.data.keys().hasAll(['topicReviewedAt']) || request.resource.data.topicReviewedAt == resource.data.topicReviewedAt)
            && request.resource.data.preferences is list
            && (request.resource.data.preferences.size() > 0
              || (get(/databases/$(database)/documents/graduationRounds/$(roundId)).data.keys().hasAll(['supervisorAssignmentMode'])
                && get(/databases/$(database)/documents/graduationRounds/$(roundId)).data.supervisorAssignmentMode == 'direct_assignment'))
            && (get(/databases/$(database)/documents/graduationRounds/$(roundId)).data.status in ['open', 'published', 'reviewing', 'finalized']
                || !get(/databases/$(database)/documents/graduationRounds/$(roundId)).data.keys().hasAll(['status']))
            && (!get(/databases/$(database)/documents/graduationRounds/$(roundId)).data.keys().hasAll(['closeAt']) 
                || request.time <= get(/databases/$(database)/documents/graduationRounds/$(roundId)).data.closeAt));

        allow delete: if admin();
      }

      // --- AUTHORIZATION INDEX LOOKUP HELPERS ---
      function councilMemberDoc(actId, cId, mEmail) {
        return /databases/$(database)/documents/graduationRounds/$(roundId)/councilMemberships/$(actId + '_' + cId + '_' + mEmail);
      }
      function isCouncilMember(actId, cId, mEmail) {
        return exists(councilMemberDoc(actId, cId, mEmail))
          && get(councilMemberDoc(actId, cId, mEmail)).data.active == true;
      }
      function isCouncilChair(actId, cId, mEmail) {
        return isCouncilMember(actId, cId, mEmail)
          && get(councilMemberDoc(actId, cId, mEmail)).data.role == 'chair';
      }
      function councilStudentDoc(actId, stId) {
        return /databases/$(database)/documents/graduationRounds/$(roundId)/councilStudentAssignments/$(actId + '_' + stId);
      }
      function isStudentInCouncil(actId, cId, stId) {
        return exists(councilStudentDoc(actId, stId))
          && get(councilStudentDoc(actId, stId)).data.councilId == cId
          && (!get(councilStudentDoc(actId, stId)).data.keys().hasAll(['active']) || get(councilStudentDoc(actId, stId)).data.active == true);
      }
      function councilAccessDoc(actId, cId) {
        return /databases/$(database)/documents/graduationRounds/$(roundId)/councilAccess/$(actId + '_' + cId);
      }
      function getCouncilStatus(actId, cId) {
        return exists(councilAccessDoc(actId, cId))
          ? get(councilAccessDoc(actId, cId)).data.status
          : 'unknown';
      }
      function supervisorDoc(stId) {
        return /databases/$(database)/documents/graduationRounds/$(roundId)/supervisorAssignments/$(stId);
      }
      function reviewerDoc(stId) {
        return /databases/$(database)/documents/graduationRounds/$(roundId)/reviewerAssignmentsAuth/$(stId);
      }
      function activityAccessDoc(actId) {
        return /databases/$(database)/documents/graduationRounds/$(roundId)/activityAccess/$(actId);
      }
      function isActivitySubmissionEnabled(actId) {
        return exists(activityAccessDoc(actId))
          && get(activityAccessDoc(actId)).data.submissionEnabled == true;
      }

      // --- AUTHORIZATION INDEX SUBCOLLECTIONS ---
      match /councilMemberships/{membershipId} {
        allow read: if admin() || (staff() && resource.data.memberEmail == email());
        allow write: if admin();
      }

      match /councilStudentAssignments/{assignmentId} {
        allow read: if admin() || staff() || (student() && email().matches('^' + resource.data.studentId + '@student\\.tdtu\\.edu\\.vn$'));
        allow write: if admin();
      }

      match /councilAccess/{councilAccessId} {
        allow read: if admin() || staff();
        allow write: if admin();
      }

      match /supervisorAssignments/{studentId} {
        allow read: if admin() || (staff() && email() in resource.data.supervisorEmails) || (student() && email().matches('^' + studentId + '@student\\.tdtu\\.edu\\.vn$'));
        allow write: if admin();
      }

      match /reviewerAssignmentsAuth/{studentId} {
        allow read: if admin() || (staff() && resource.data.reviewerEmail == email()) || (student() && email().matches('^' + studentId + '@student\\.tdtu\\.edu\\.vn$'));
        allow write: if admin();
      }

      match /preliminaryScorers/{scorerEmail} {
        allow read: if admin() || (staff() && resource.data.email == email());
        allow write: if admin();
      }

      match /activityAccess/{activityId} {
        allow read: if signedIn();
        allow write: if admin();
      }

      // Điểm chấm Hội đồng độc lập (councilScores)
      match /councilScores/{scoreId} {
        allow read: if admin()
          || (staff() && resource.data.scorerEmail == email())
          || (staff()
              && isCouncilChair(resource.data.activityId, resource.data.councilId, email())
              && getCouncilStatus(resource.data.activityId, resource.data.councilId) in ['ended', 'finalized']);

        allow create: if admin()
          || (staff()
              && request.resource.data.scorerEmail == email()
              && request.resource.data.scorerId is string
              && request.resource.data.studentId is string
              && request.resource.data.activityId is string
              && request.resource.data.councilId is string
              && request.resource.data.roundId == roundId
              && request.resource.data.scoreId == (request.resource.data.activityId + '_' + request.resource.data.councilId + '_' + request.resource.data.studentId + '_' + request.resource.data.scorerId)
              && scoreId == request.resource.data.scoreId
              && (!('score' in request.resource.data) || (request.resource.data.score is number && request.resource.data.score >= 0 && request.resource.data.score <= 10))
              && isCouncilMember(request.resource.data.activityId, request.resource.data.councilId, email())
              && isStudentInCouncil(request.resource.data.activityId, request.resource.data.councilId, request.resource.data.studentId));

        allow update: if (admin()
              && request.resource.data.scorerEmail == resource.data.scorerEmail
              && request.resource.data.scorerId == resource.data.scorerId
              && request.resource.data.studentId == resource.data.studentId
              && request.resource.data.activityId == resource.data.activityId
              && request.resource.data.councilId == resource.data.councilId
              && request.resource.data.roundId == resource.data.roundId)
          || (staff()
              && resource.data.scorerEmail == email()
              && request.resource.data.scorerEmail == email()
              && request.resource.data.scorerId == resource.data.scorerId
              && request.resource.data.studentId == resource.data.studentId
              && request.resource.data.activityId == resource.data.activityId
              && request.resource.data.councilId == resource.data.councilId
              && request.resource.data.roundId == resource.data.roundId
              && (!('score' in request.resource.data) || (request.resource.data.score is number && request.resource.data.score >= 0 && request.resource.data.score <= 10))
              && isCouncilMember(resource.data.activityId, resource.data.councilId, email())
              && getCouncilStatus(resource.data.activityId, resource.data.councilId) in ['preparing', 'active', 'open'])
          || (staff()
              && isCouncilChair(resource.data.activityId, resource.data.councilId, email())
              && request.resource.data.councilId == resource.data.councilId
              && request.resource.data.studentId == resource.data.studentId
              && request.resource.data.activityId == resource.data.activityId
              && request.resource.data.scorerId == resource.data.scorerId
              && request.resource.data.scorerEmail == resource.data.scorerEmail
              && request.resource.data.roundId == resource.data.roundId
              && getCouncilStatus(resource.data.activityId, resource.data.councilId) == 'ended'
              && (!('score' in request.resource.data) || (request.resource.data.score is number && request.resource.data.score >= 0 && request.resource.data.score <= 10)));

        allow delete: if false;
      }

      // Quản lý Nộp bài độc lập (submissions)
      match /submissions/{submissionId} {
        allow read: if admin()
          || (student() && email().matches('^' + resource.data.studentId + '@student\\.tdtu\\.edu\\.vn$'))
          || (staff()
              && (
                (get(activityAccessDoc(resource.data.activityId)).data.supervisorCanView == true
                 && email() in get(supervisorDoc(resource.data.studentId)).data.supervisorEmails)
                ||
                (get(activityAccessDoc(resource.data.activityId)).data.reviewerCanView == true
                 && get(reviewerDoc(resource.data.studentId)).data.reviewerEmail == email())
                ||
                (get(activityAccessDoc(resource.data.activityId)).data.councilCanView == true
                 && get(councilMemberDoc(resource.data.activityId, get(councilStudentDoc(resource.data.activityId, resource.data.studentId)).data.councilId, email())).data.active == true)
              ));

        allow create: if admin()
          || (student()
              && request.resource.data.studentId is string
              && email().matches('^' + request.resource.data.studentId + '@student\\.tdtu\\.edu\\.vn$')
              && request.resource.data.submittedBy == email()
              && request.resource.data.roundId == roundId
              && request.resource.data.activityId is string
              && request.resource.data.submissionId == submissionId
              && request.resource.data.status in ['submitted', 'uploading', 'draft']
              && request.resource.data.files is list
              && request.resource.data.attemptNumber is int
              && request.resource.data.attemptNumber >= 1
              && exists(/databases/$(database)/documents/graduationRounds/$(roundId)/eligibleStudents/$(request.resource.data.studentId))
              && get(/databases/$(database)/documents/graduationRounds/$(roundId)/eligibleStudents/$(request.resource.data.studentId)).data.eligible == true
              && isActivitySubmissionEnabled(request.resource.data.activityId));

        allow update: if (student()
              && email().matches('^' + resource.data.studentId + '@student\\.tdtu\\.edu\\.vn$')
              && resource.data.status in ['submitted', 'uploading', 'draft']
              && request.resource.data.status == 'withdrawn'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'withdrawnAt', 'updatedAt'])
              && request.resource.data.studentId == resource.data.studentId
              && request.resource.data.roundId == resource.data.roundId
              && request.resource.data.activityId == resource.data.activityId)
          || (admin()
              && request.resource.data.studentId == resource.data.studentId
              && request.resource.data.roundId == resource.data.roundId
              && request.resource.data.activityId == resource.data.activityId);

        allow delete: if false;
      }

      // Nhật ký kiểm toán đợt
      match /auditLogs/{logId} {
        allow read: if admin();

        allow create: if (admin() && request.resource.data.by == email())
          || (student()
              && request.resource.data.by == email()
              && request.resource.data.action in ['Nộp bài', 'Rút bài', 'Nộp bài bổ sung']
              && request.resource.data.roundId == roundId)
          || (staff()
              && request.resource.data.by == email()
              && request.resource.data.action in ['Chấm điểm', 'Cập nhật điểm', 'Lưu nháp điểm']
              && request.resource.data.roundId == roundId);

        allow update: if false;
        allow delete: if false;
      }
    }
  }
}
