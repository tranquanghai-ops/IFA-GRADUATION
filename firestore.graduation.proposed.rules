rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn(){ return request.auth != null && request.auth.token.email_verified == true; }
    function email(){ return request.auth.token.email; }
    function student(){ return signedIn() && email().matches('^[^@]+@student\\.tdtu\\.edu\\.vn$'); }
    function staff(){ return signedIn() && email().matches('^[^@]+@tdtu\\.edu\\.vn$'); }
    function owner(){ return staff() && email() == 'tranquanghai@tdtu.edu.vn'; }
    function admin(){ return owner() || (signedIn() && exists(/databases/$(database)/documents/admins/$(email()))); }
    function participant(){ return student() || staff() || admin(); }
    function highAdmin(){ return owner() || (admin() && get(/databases/$(database)/documents/admins/$(email())).data.role == 'admin'); }
    function assignmentPath(sessionId){ return /databases/$(database)/documents/scannerAssignments/$(sessionId + '_' + email()); }
    function assigned(sessionId){ return signedIn() && exists(assignmentPath(sessionId)) && get(assignmentPath(sessionId)).data.active == true; }
    function leader(sessionId){ return assigned(sessionId) && get(assignmentPath(sessionId)).data.role == 'leader'; }
    function attendanceSession(sessionId){ return get(/databases/$(database)/documents/attendanceSessions/$(sessionId)).data; }
    function attendanceAccepting(sessionId){
      return attendanceSession(sessionId).status == 'open'
        && (!attendanceSession(sessionId).keys().hasAll(['startAt'])
          || request.time >= attendanceSession(sessionId).startAt)
        && (!attendanceSession(sessionId).keys().hasAll(['endAt'])
          || request.time <= attendanceSession(sessionId).endAt);
    }
    function eventAfter(id){ return getAfter(/databases/$(database)/documents/events/$(id)).data; }
    function eventBefore(id){ return get(/databases/$(database)/documents/events/$(id)).data; }
    function regPath(uid,id){ return /databases/$(database)/documents/registrations/$(uid + '_' + id); }
    function profilePath(uid){ return /databases/$(database)/documents/profiles/$(uid); }
    function groupPath(id){ return /databases/$(database)/documents/eventGroups/$(id); }
    function limitPath(uid,id){ return /databases/$(database)/documents/registrationLimits/$(uid + '_' + id); }
    function limitAfter(uid,id){ return getAfter(limitPath(uid,id)).data; }
    function groupedEvent(id){ return eventBefore(id).groupId != ''; }
    function unlimitedGroup(id){
      return get(groupPath(id)).data.keys().hasAll(['unlimited'])
        && get(groupPath(id)).data.unlimited == true;
    }
    function facultyAllowed(eventId, uid){
      return !eventBefore(eventId).keys().hasAll(['allowedFaculties'])
        || eventBefore(eventId).allowedFaculties.hasAny([get(profilePath(uid)).data.faculty]);
    }
    function validEventGroup(data){
      return data.groupId == ''
        || (exists(groupPath(data.groupId))
          && data.groupName == get(groupPath(data.groupId)).data.name
          && data.groupMaxRegistrations == get(groupPath(data.groupId)).data.maxRegistrations);
    }

    match /settings/main {
      allow read: if true;
      allow create, update: if owner();
      allow delete: if highAdmin();
    }

    match /admins/{adminEmail} {
      allow get: if owner() || (signedIn() && email() == adminEmail);
      allow list, create, update, delete: if owner();
    }

    match /storageAdminAccess/{uid} {
      allow get: if owner() || (admin() && uid == request.auth.uid);
      allow list, delete: if owner();
      allow create, update: if admin()
        && uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == email()
        && request.resource.data.role in ['admin', 'subadmin'];
    }

    match /favoriteScannerLists/{ownerUid} {
      allow get: if admin() && ownerUid == request.auth.uid;
      allow list: if false;
      allow create, update: if admin()
        && ownerUid == request.auth.uid
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.students is list
        && request.resource.data.students.size() <= 100;
      allow delete: if admin() && ownerUid == request.auth.uid;
    }

    match /profiles/{uid} {
      allow get: if admin() || (participant() && uid == request.auth.uid);
      allow list: if admin();
      allow create: if participant() && uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == email()
        && request.resource.data.name is string
        && request.resource.data.phone is string
        && request.resource.data.faculty is string;
      allow update: if participant() && uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.name is string
        && request.resource.data.phone is string
        && request.resource.data.faculty is string;
      allow delete: if highAdmin();
    }

    match /eventGroups/{groupId} {
      allow read: if true;
      allow create: if admin()
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.name is string
        && (!request.resource.data.keys().hasAll(['unlimited']) || request.resource.data.unlimited is bool)
        && request.resource.data.maxRegistrations is int
        && request.resource.data.maxRegistrations >= 1
        && request.resource.data.maxRegistrations <= 20;
      allow update: if (highAdmin() || (admin() && resource.data.createdByUid == request.auth.uid))
        && request.resource.data.createdByUid == resource.data.createdByUid
        && request.resource.data.createdByEmail == resource.data.createdByEmail
        && request.resource.data.createdAt == resource.data.createdAt
        && (!request.resource.data.keys().hasAll(['unlimited']) || request.resource.data.unlimited is bool)
        && request.resource.data.maxRegistrations is int
        && request.resource.data.maxRegistrations >= 1
        && request.resource.data.maxRegistrations <= 20;
      allow delete: if false;
    }

    match /events/{eventId} {
      allow read: if true;
      allow create: if admin()
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.registeredCount == 0
        && request.resource.data.allowedFaculties is list
        && request.resource.data.allowedFaculties.size() >= 1
        && validEventGroup(request.resource.data);
      allow update: if ((highAdmin() || (admin() && resource.data.createdByUid == request.auth.uid))
        && request.resource.data.createdByUid == resource.data.createdByUid
        && request.resource.data.createdByEmail == resource.data.createdByEmail
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.registeredCount is int
        && request.resource.data.registeredCount >= 0
        && request.resource.data.registeredCount <= resource.data.registeredCount
        && request.resource.data.capacity >= resource.data.registeredCount
        && request.resource.data.allowedFaculties is list
        && request.resource.data.allowedFaculties.size() >= 1
        && (resource.data.registeredCount == 0 || request.resource.data.groupId == resource.data.groupId)
        && validEventGroup(request.resource.data))
        || (participant()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['registeredCount','updatedAt'])
        && (
          (request.resource.data.registeredCount == resource.data.registeredCount + 1
            && resource.data.status == 'open'
            && resource.data.registeredCount < resource.data.capacity
            && facultyAllowed(eventId, request.auth.uid)
            && (resource.data.openAt == null || request.time >= resource.data.openAt)
            && (resource.data.closeAt == null || request.time <= resource.data.closeAt)
            && existsAfter(regPath(request.auth.uid,eventId)))
          ||
          (request.resource.data.registeredCount == resource.data.registeredCount - 1
            && request.resource.data.registeredCount >= 0
            && resource.data.keys().hasAll(['allowCancellation'])
            && resource.data.allowCancellation == true
            && !existsAfter(regPath(request.auth.uid,eventId)))
        ));
      allow delete: if resource.data.registeredCount == 0
        && (owner() || (admin() && resource.data.createdByUid == request.auth.uid));
    }

    match /registrations/{regId} {
      allow list: if admin() || (participant() && resource.data.uid == request.auth.uid);
      allow get: if admin() || (participant() && (regId.matches('^' + request.auth.uid + '_.*$') || resource.data.uid == request.auth.uid));
      allow create: if participant()
        && exists(profilePath(request.auth.uid))
        && regId == request.auth.uid + '_' + request.resource.data.eventId
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == email()
        && facultyAllowed(request.resource.data.eventId, request.auth.uid)
        && request.resource.data.groupId == eventBefore(request.resource.data.eventId).groupId
        && eventAfter(request.resource.data.eventId).registeredCount == eventBefore(request.resource.data.eventId).registeredCount + 1
        && (!groupedEvent(request.resource.data.eventId)
          || (existsAfter(limitPath(request.auth.uid,request.resource.data.groupId))
            && limitAfter(request.auth.uid,request.resource.data.groupId).eventIds.hasAll([request.resource.data.eventId])
            && limitAfter(request.auth.uid,request.resource.data.groupId).count == (exists(limitPath(request.auth.uid,request.resource.data.groupId))
              ? get(limitPath(request.auth.uid,request.resource.data.groupId)).data.count + 1 : 1)));
      allow delete: if admin() || (participant()
        && resource.data.uid == request.auth.uid
        && eventBefore(resource.data.eventId).keys().hasAll(['allowCancellation'])
        && eventBefore(resource.data.eventId).allowCancellation == true
        && eventAfter(resource.data.eventId).registeredCount == eventBefore(resource.data.eventId).registeredCount - 1
        && (!groupedEvent(resource.data.eventId)
          || (existsAfter(limitPath(request.auth.uid,resource.data.groupId))
            && !limitAfter(request.auth.uid,resource.data.groupId).eventIds.hasAny([resource.data.eventId])
            && limitAfter(request.auth.uid,resource.data.groupId).count == get(limitPath(request.auth.uid,resource.data.groupId)).data.count - 1)));
      allow update: if false;
    }

    match /registrationLimits/{limitId} {
      allow get: if admin() || (participant() && limitId.matches('^' + request.auth.uid + '_.*$'));
      allow list: if admin() || (participant() && resource.data.uid == request.auth.uid);
      allow create: if participant()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == email()
        && limitId == request.auth.uid + '_' + request.resource.data.groupId
        && exists(groupPath(request.resource.data.groupId))
        && request.resource.data.maxRegistrations == get(groupPath(request.resource.data.groupId)).data.maxRegistrations
        && request.resource.data.count is int
        && request.resource.data.count >= 0
        && (unlimitedGroup(request.resource.data.groupId)
          || request.resource.data.count <= get(groupPath(request.resource.data.groupId)).data.maxRegistrations)
        && request.resource.data.eventIds.size() == request.resource.data.count;
      allow update: if (admin()
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.groupId == resource.data.groupId
        && request.resource.data.maxRegistrations == resource.data.maxRegistrations
        && request.resource.data.count is int
        && request.resource.data.count >= 0
        && request.resource.data.eventIds is list
        && request.resource.data.eventIds.size() == request.resource.data.count)
        || (participant()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == email()
        && limitId == request.auth.uid + '_' + request.resource.data.groupId
        && exists(groupPath(request.resource.data.groupId))
        && request.resource.data.maxRegistrations == get(groupPath(request.resource.data.groupId)).data.maxRegistrations
        && request.resource.data.count is int
        && request.resource.data.count >= 0
        && (unlimitedGroup(request.resource.data.groupId)
          || request.resource.data.count <= get(groupPath(request.resource.data.groupId)).data.maxRegistrations)
        && request.resource.data.eventIds.size() == request.resource.data.count);
      allow delete: if false;
    }

    match /attendanceSessions/{sessionId} {
      allow read: if signedIn();
      allow create: if admin()
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.status == 'open';
      allow update: if highAdmin()
        || (admin()
          && resource.data.createdByUid == request.auth.uid
          && resource.data.status != 'finalized'
          && request.resource.data.status != 'finalized'
          && (resource.data.status != 'ended'
            || request.resource.data.status != 'open'
            || (resource.data.endedAt is timestamp
              && request.time <= resource.data.endedAt + duration.value(5, 'd'))))
        || (assigned(sessionId)
          && resource.data.status == 'open'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['checkinCount','pendingCount','updatedAt'])
          && request.resource.data.checkinCount is int
          && request.resource.data.pendingCount is int
          && request.resource.data.checkinCount >= 0
          && request.resource.data.pendingCount >= 0
          && (!resource.data.keys().hasAll(['checkinCount','pendingCount'])
            || (request.resource.data.checkinCount >= resource.data.checkinCount - 1
              && request.resource.data.checkinCount <= resource.data.checkinCount + 1
              && request.resource.data.pendingCount >= resource.data.pendingCount - 1
              && request.resource.data.pendingCount <= resource.data.pendingCount + 1)));
      allow delete: if highAdmin();
    }

    match /facultyStudents/{mssv} {
      allow get: if participant();
      allow list: if admin();
      allow create, update: if highAdmin()
        && request.resource.data.mssv == mssv
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 150;
      allow delete: if highAdmin();
    }
    match /facultyStudentMeta/{metaId} {
      allow read: if participant();
      allow create, update, delete: if highAdmin();
    }

    match /attendanceRoster/{rosterId} {
      allow read: if admin() || assigned(resource.data.sessionId);
      allow create, update: if admin();
      allow delete: if highAdmin();
    }

    match /scannerAssignments/{assignmentId} {
      allow get: if admin() || (signedIn() && resource.data.email == email());
      allow list: if admin();
      allow create: if admin()
        && attendanceSession(request.resource.data.sessionId).status != 'finalized';
      allow update: if admin()
        && request.resource.data.sessionId == resource.data.sessionId
        && attendanceSession(resource.data.sessionId).status != 'finalized';
      allow delete: if highAdmin()
        || (admin() && attendanceSession(resource.data.sessionId).status != 'finalized');
    }

    match /attendanceGrants/{grantId} {
      allow read: if highAdmin();
      allow create, update: if admin();
      allow delete: if highAdmin();
    }

    match /auditLogs/{logId} {
      allow read: if highAdmin();
      allow create: if admin()
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.actorEmail == email();
      allow update, delete: if false;
    }

    match /checkins/{checkinId} {
      allow get, list: if admin()
        || (student() && resource.data.email == email())
        || (assigned(resource.data.sessionId)
          && attendanceSession(resource.data.sessionId).status != 'finalized');
      allow create: if (admin() || assigned(request.resource.data.sessionId))
        && attendanceAccepting(request.resource.data.sessionId)
        && request.resource.data.mssv is string
        && request.resource.data.mssv.size() <= 12
        && request.resource.data.scannerUid == request.auth.uid
        && request.resource.data.scannerEmail == email();
      allow update: if (admin()
          && attendanceSession(resource.data.sessionId).status != 'finalized')
        || (leader(resource.data.sessionId)
          && attendanceAccepting(resource.data.sessionId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deletedAt','deletedByUid','deletedByEmail']))
        || ((leader(resource.data.sessionId)
            || (assigned(resource.data.sessionId) && resource.data.scannerUid == request.auth.uid))
          && attendanceAccepting(resource.data.sessionId)
          && resource.data.mssv == ''
          && request.resource.data.mssv is string
          && request.resource.data.mssv.size() >= 8
          && request.resource.data.mssv.size() <= 12
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['mssv','name','email','studentUid']));
      allow delete: if highAdmin();
    }

    // ==========================================
    // IFA+ GRADUATION (ĐỒ ÁN TỐT NGHIỆP)
    // ==========================================
    
    // Kho GVHD Master
    match /supervisorMaster/{supervisorId} {
      allow read: if signedIn();
      allow create, update, delete: if admin();
    }

    // Danh mục Loại hình đồ án
    match /graduationProjectTypes/{typeId} {
      allow read: if signedIn();
      allow create, update, delete: if admin();
    }

    // Các Đợt Đồ án Tốt nghiệp
    match /graduationRounds/{roundId} {
      allow read: if signedIn();
      allow create, update, delete: if admin();

      // GVHD tham gia đợt (kèm quota của đợt)
      match /supervisors/{supervisorId} {
        allow read: if signedIn();
        allow create, delete: if admin();
        allow update: if admin() || (staff() && (email() == supervisorId || email() == resource.data.email));
      }

      // Danh sách sinh viên đủ điều kiện
      match /eligibleStudents/{studentId} {
        allow get: if admin() || (student() && email().matches('^' + studentId + '@student\\.tdtu\\.edu\\.vn$'));
        allow list: if admin();
        allow create, update, delete: if admin();
      }

      // Quyết định xét duyệt của GVHD từng vòng
      match /reviewDecisions/{decisionId} {
        allow read: if admin() || staff();
        allow create, update: if admin() || (staff() && (email() == request.resource.data.supervisorEmail || email() == request.resource.data.decidedBy));
        allow delete: if admin();
      }

      // Đăng ký nguyện vọng của sinh viên
      match /registrations/{studentId} {
        // Đọc: Admin, hoặc GVHD có trong đợt, hoặc chính SV đăng ký
        allow get: if admin() 
          || (student() && email().matches('^' + studentId + '@student\\.tdtu\\.edu\\.vn$'))
          || (staff() && exists(/databases/$(database)/documents/graduationRounds/$(roundId)/supervisors/$(email())));
        allow list: if admin() || staff();

        // Tạo mới: Chỉ sinh viên chính chủ, đủ điều kiện, đợt open, trong khoảng thời gian mở/đóng
        allow create: if student()
          && email().matches('^' + studentId + '@student\\.tdtu\\.edu\\.vn$')
          && request.resource.data.studentId == studentId
          && request.resource.data.email == email()
          && request.resource.data.status == 'submitted'
          && request.resource.data.topicTitle is string
          && request.resource.data.topicTitle.size() > 0
          && request.resource.data.topicTitle.size() <= 250
          && request.resource.data.projectType is string
          && request.resource.data.preferences is list
          && request.resource.data.preferences.size() > 0
          && exists(/databases/$(database)/documents/graduationRounds/$(roundId)/eligibleStudents/$(studentId))
          && get(/databases/$(database)/documents/graduationRounds/$(roundId)/eligibleStudents/$(studentId)).data.eligible == true
          && get(/databases/$(database)/documents/graduationRounds/$(roundId)).data.status == 'open'
          && (!get(/databases/$(database)/documents/graduationRounds/$(roundId)).data.keys().hasAll(['openAt']) 
              || request.time >= get(/databases/$(database)/documents/graduationRounds/$(roundId)).data.openAt)
          && (!get(/databases/$(database)/documents/graduationRounds/$(roundId)).data.keys().hasAll(['closeAt']) 
              || request.time <= get(/databases/$(database)/documents/graduationRounds/$(roundId)).data.closeAt);

        // Cập nhật: Admin (duyệt/chốt/phân công) HOẶC Sinh viên chính chủ khi đợt mở và cho phép sửa
        allow update: if (admin())
          || (student()
            && email().matches('^' + studentId + '@student\\.tdtu\\.edu\\.vn$')
            && resource.data.email == email()
            && request.resource.data.studentId == studentId
            && request.resource.data.email == email()
            && request.resource.data.status == resource.data.status
            && request.resource.data.topicTitle is string
            && request.resource.data.topicTitle.size() > 0
            && request.resource.data.topicTitle.size() <= 250
            && request.resource.data.projectType is string
            && request.resource.data.preferences is list
            && request.resource.data.preferences.size() > 0
            && get(/databases/$(database)/documents/graduationRounds/$(roundId)).data.status == 'open'
            && get(/databases/$(database)/documents/graduationRounds/$(roundId)).data.allowStudentEdit == true
            && (!get(/databases/$(database)/documents/graduationRounds/$(roundId)).data.keys().hasAll(['closeAt']) 
                || request.time <= get(/databases/$(database)/documents/graduationRounds/$(roundId)).data.closeAt));

        allow delete: if admin();
      }

      // ============================================================================
      // PROPOSED RULES FOR v2.3.2 (HARDENED SUBCOLLECTIONS - DO NOT DEPLOY YET)
      // ============================================================================

      // 1. Điểm chấm Hội đồng độc lập (councilScores)
      match /councilScores/{scoreId} {
        // Đọc: Chỉ Admin hoặc chính Giảng viên chấm điểm đó (Least Privilege - Không Staff Wildcard)
        // Sinh viên tuyệt đối không được đọc điểm nội bộ hội đồng.
        allow read: if admin()
          || (staff() && resource.data.scorerEmail == email());

        // Tạo mới: Admin hoặc Giảng viên chấm điểm chính chủ
        // Bắt buộc ràng buộc định danh: scorerEmail == auth.email, scoreId khớp format
        allow create: if admin()
          || (staff()
              && request.resource.data.scorerEmail == email()
              && request.resource.data.scorerId is string
              && request.resource.data.studentId is string
              && request.resource.data.activityId is string
              && request.resource.data.councilId is string
              && request.resource.data.roundId == roundId
              && request.resource.data.scoreId == (request.resource.data.activityId + '_' + request.resource.data.councilId + '_' + request.resource.data.studentId + '_' + request.resource.data.scorerId)
              && scoreId == request.resource.data.scoreId
              && (!('score' in request.resource.data) || (request.resource.data.score is number && request.resource.data.score >= 0 && request.resource.data.score <= 10)));

        // Cập nhật:
        // 1) Giảng viên chấm cập nhật phiếu điểm chính chủ:
        //    BẢO TOÀN TRƯỜNG ĐỊNH DANH (IMMUTABLE IDENTITY FIELDS): không được đổi scorerEmail, studentId, activityId, councilId, scorerId, roundId.
        // 2) Admin hiệu chỉnh điểm (Calibration): identity fields vẫn BẤT BIẾN, chỉ chỉnh sửa điểm/nhận xét/calibration metadata.
        // GHI CHÚ: Chair calibration từ client bị chặn ở Database Rules do dữ liệu phân công hội đồng nằm nested,
        // Chair calibration phải qua Admin workflow hoặc chờ Authorization Index Docs.
        allow update: if (staff()
              && resource.data.scorerEmail == email()
              && request.resource.data.scorerEmail == email()
              && request.resource.data.scorerId == resource.data.scorerId
              && request.resource.data.studentId == resource.data.studentId
              && request.resource.data.activityId == resource.data.activityId
              && request.resource.data.councilId == resource.data.councilId
              && request.resource.data.roundId == resource.data.roundId
              && (!('score' in request.resource.data) || (request.resource.data.score is number && request.resource.data.score >= 0 && request.resource.data.score <= 10)))
          || (admin()
              && request.resource.data.scorerEmail == resource.data.scorerEmail
              && request.resource.data.scorerId == resource.data.scorerId
              && request.resource.data.studentId == resource.data.studentId
              && request.resource.data.activityId == resource.data.activityId
              && request.resource.data.councilId == resource.data.councilId
              && request.resource.data.roundId == resource.data.roundId);

        // KHÔNG XÓA PHIẾU ĐIỂM: Mark voided/revoked + audit thay vì delete vật lý
        allow delete: if false;
      }

      // 2. Từng lần nộp bài của Sinh viên (submissions)
      match /submissions/{submissionId} {
        // Đọc: Admin hoặc chính Sinh viên nộp bài (Không Staff Wildcard)
        // GHI CHÚ: Giảng viên hướng dẫn / Phản biện / Hội đồng đọc file nộp cần Authorization Index Docs hoặc Trusted Backend.
        allow read: if admin()
          || (student() && email().matches('^' + resource.data.studentId + '@student\\.tdtu\\.edu\\.vn$'));

        // Tạo mới: Admin hoặc chính Sinh viên nộp bài cho bản thân
        allow create: if admin()
          || (student()
              && request.resource.data.studentId is string
              && email().matches('^' + request.resource.data.studentId + '@student\\.tdtu\\.edu\\.vn$')
              && request.resource.data.submittedBy == email()
              && request.resource.data.roundId == roundId
              && request.resource.data.activityId is string
              && request.resource.data.submissionId == submissionId
              && request.resource.data.status in ['submitted', 'uploading', 'draft']
              && request.resource.data.files is list
              && request.resource.data.attemptNumber is int
              && request.resource.data.attemptNumber >= 1);

        // Cập nhật:
        // Sinh viên chỉ được RÚT BÀI (chuyển status từ submitted/uploading/draft sang withdrawn).
        // Tuyệt đối không cho phép đổi files, studentId, roundId, activityId hoặc chuyển withdrawn -> submitted.
        allow update: if (student()
              && email().matches('^' + resource.data.studentId + '@student\\.tdtu\\.edu\\.vn$')
              && resource.data.status in ['submitted', 'uploading', 'draft']
              && request.resource.data.status == 'withdrawn'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'withdrawnAt', 'updatedAt'])
              && request.resource.data.studentId == resource.data.studentId
              && request.resource.data.roundId == resource.data.roundId
              && request.resource.data.activityId == resource.data.activityId)
          || (admin()
              && request.resource.data.studentId == resource.data.studentId
              && request.resource.data.roundId == resource.data.roundId
              && request.resource.data.activityId == resource.data.activityId);

        // BẢO TỒN LỊCH SỬ NỘP BÀI: Tuyệt đối không xóa bản ghi nộp
        allow delete: if false;
      }

      // 3. Nhật ký kiểm toán Bất biến (auditLogs)
      match /auditLogs/{logId} {
        // Đọc: Chỉ Admin (Không Staff Read All, Không Student Read)
        allow read: if admin();

        // Tạo mới: Chỉ cho phép các action hợp lệ theo whitelist vai trò (Không cho client tùy ý ghi)
        // - Admin: mọi action hợp lệ
        // - Sinh viên: chỉ action nộp bài / rút bài của chính mình
        // - Giảng viên: chỉ action chấm điểm / lưu nháp của chính mình
        allow create: if (admin() && request.resource.data.by == email())
          || (student()
              && request.resource.data.by == email()
              && request.resource.data.action in ['Nộp bài', 'Rút bài', 'Nộp bài bổ sung']
              && request.resource.data.roundId == roundId)
          || (staff()
              && request.resource.data.by == email()
              && request.resource.data.action in ['Chấm điểm', 'Cập nhật điểm', 'Lưu nháp điểm']
              && request.resource.data.roundId == roundId);

        // BẤT BIẾN: Tuyệt đối không cho phép sửa hoặc xóa nhật ký kiểm toán
        allow update: if false;
        allow delete: if false;
      }
    }
  }
}
