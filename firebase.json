{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "firestore.rules",
      "firestore.indexes.json",
      "functions/**",
      "node_modules/**",
      ".git/**",
      ".github/**",
      ".gemini/**",
      "tests/**",
      "scripts/**",
      "docs/**",
      "output/**",
      "*.md",
      "package.json",
      "package-lock.json",
      "index.template.html"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "emulators": {
    "firestore": {
      "port": 8088
    }
  }
}